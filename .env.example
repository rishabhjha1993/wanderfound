NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_VERSION=
# Public by design: restrict this key to Wanderfound websites and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Cloud → Google Maps Platform → Map Management → JavaScript map ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Secret: restrict to Places API (New). Never prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=
# Secret OpenAI project key used only by server routes.
AI_API_KEY=
# Founder diagnostic tooling at /debug/playability. Always on outside
# production; set to exactly "true" to enable on a deployment for field
# diagnosis. Leave unset in production unless you mean it.
WANDERFOUND_DEBUG_TOOLS=
AI_TEXT_MODEL=gpt-5.6-sol
AI_VISION_MODEL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google OAuth Client ID and Client Secret belong in the Supabase Dashboard:
# Authentication → Sign In / Providers → Google
SUPABASE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
